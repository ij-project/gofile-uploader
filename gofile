#!/bin/bash

# Check argument
if [[ $# -eq 0 ]]; then
    echo "ERROR: No File Specified!"
    exit 1
fi

FILE="$1"

# Validate file
if [[ ! -f "$FILE" ]]; then
    echo "ERROR: File not found: $FILE"
    exit 1
fi

# Check jq
command -v jq >/dev/null || {
    echo "ERROR: jq not installed. Install via: sudo apt install jq"
    exit 1
}

echo "📁 File: $FILE"
echo "📡 Fetching best GoFile upload server..."

# Dynamically query available server
SERVER_RESP=$(curl -s "https://api.gofile.io/servers")
SERVER=$(echo "$SERVER_RESP" | jq -r '.data.servers[0].name // .data.server // empty')

# Fallback endpoint if needed
if [[ -z "$SERVER" ]]; then
    SERVER=$(curl -s "https://api.gofile.io/getServer" | jq -r '.data.server // empty')
fi

if [[ -z "$SERVER" ]]; then
    echo "🚫 Failed to retrieve an active GoFile server."
    exit 1
fi

echo "➡️  Selected server: $SERVER"
echo "🚀 Uploading..."
echo

# Perform upload to updated endpoint path (/contents/uploadfile)
RESP=$(curl -4 --http1.1 --progress-bar \
    -F "file=@${FILE}" \
    "https://${SERVER}.gofile.io/contents/uploadfile")

# Check status
STATUS=$(echo "$RESP" | jq -r '.status // empty')

if [[ "$STATUS" == "ok" ]]; then
    LINK=$(echo "$RESP" | jq -r '.data.downloadPage')
    echo
    echo "✅ **Upload Successful!**"
    echo "🔗 Link: $LINK"
else
    echo
    echo "🚫 Upload failed."
    echo "Response: $RESP"
    exit 1
fi

echo
echo "🎉 Done!"
