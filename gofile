#!/bin/bash

# Check argument
if [[ $# -eq 0 ]]; then
    echo "ERROR: No File Specified!"
    exit 1
fi

FILE="$1"

# Validate file
if [[ ! -f "$FILE" ]]; then
    echo "ERROR: File not found: $FILE"
    exit 1
fi

# Check jq
command -v jq >/dev/null || {
    echo "ERROR: jq not installed. Install via: sudo apt install jq"
    exit 1
}

echo "📁 File: $FILE"
echo "📡 Generating GoFile guest account token..."

# Create a guest account to receive a valid token
ACCOUNT_RESP=$(curl -s -X POST "https://api.gofile.io/accounts")
TOKEN=$(echo "$ACCOUNT_RESP" | jq -r '.data.token // empty')

if [[ -z "$TOKEN" ]]; then
    echo "🚫 Failed to retrieve a GoFile API token."
    echo "Response: $ACCOUNT_RESP"
    exit 1
fi

echo "🚀 Uploading file..."
echo

# Upload directly to the global upload fleet endpoint
RESP=$(curl --progress-bar \
    -H "Authorization: Bearer ${TOKEN}" \
    -F "file=@${FILE}" \
    "https://upload.gofile.io/uploadfile")

# Extract status safely
STATUS=$(echo "$RESP" | jq -r '.status // empty' 2>/dev/null)

if [[ "$STATUS" == "ok" ]]; then
    LINK=$(echo "$RESP" | jq -r '.data.downloadPage')
    echo
    echo "✅ **Upload Successful!**"
    echo "🔗 Link: $LINK"
else
    echo
    echo "🚫 Upload failed."
    echo "Response: $RESP"
    exit 1
fi

echo
echo "🎉 Done!"
